diff --git a/bsd/sweet_hfs/sweet_hfs_compat.h b/bsd/sweet_hfs/sweet_hfs_compat.h
--- a/bsd/sweet_hfs/sweet_hfs_compat.h
+++ b/bsd/sweet_hfs/sweet_hfs_compat.h
@@ -14,6 +14,26 @@
 #undef FIFO
 #include "core/kext-config.h"
 
+/* This copy is linked into XNU, so HFS may use the matching kernel-private APIs. */
+#define BSD_KERNEL_PRIVATE 1
+#define XNU_KERNEL_PRIVATE 1
+
+/* A24's initial port has no AppleKeyStore/cprotect service. Keep HFS compression. */
+#undef CONFIG_PROTECT
+#define CONFIG_PROTECT 0
+
+/* HFS sysctl tuning is optional; use conservative defaults in this bring-up build. */
+#include <sys/types.h>
+#include <sys/sysctl.h>
+static inline int sweet_hfs_sysctlbyname(const char *name, void *oldp, size_t *oldlenp, void *newp, size_t newlen)
+{ (void)name; (void)oldp; (void)oldlenp; (void)newp; (void)newlen; return -1; }
+#define sysctlbyname(...) sweet_hfs_sysctlbyname(__VA_ARGS__)
+
+#if HFS_COMPRESSION
+struct cnode;
+int hfs_file_is_compressed(struct cnode *cp, int skiplock);
+#endif
+
 /* Built in, not a loadable kext (see sweet_hfs_iokit.c). */
 #define OSKextGetCurrentLoadTag sweet_hfs_current_load_tag
 #endif
